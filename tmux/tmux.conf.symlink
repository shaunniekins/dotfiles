# ============================================================================
# TMUX LOCAL CONFIGURATION (overrides ~/.tmux.conf)
# ============================================================================
# Navigation Quick Reference:
# - Window switching: prefix + n (next) | p (prev) | [number] | ^ (last)
# - List windows: prefix + w
# - Rename window: prefix + ,
# - Rename session: prefix + $
# - Pane switching: prefix + h/j/k/l (vim-style)
# 
# Plugin Management (prefix = Ctrl+b):
# - Install plugins: prefix + I
# - Update plugins: prefix + U  
# - Uninstall plugins: prefix + alt + u
# ============================================================================

# ============================================================================
# GENERAL SETTINGS
# ============================================================================
# Use tmux-256color instead of screen-256color.
# This properly advertises true color and OSC support, preventing
# escape sequence responses (e.g. color queries) from leaking as
# garbage text like "10;rgb:e6e6/eded/f3f3..." in unfocused panes.
set -g default-terminal "tmux-256color"

# Tell tmux that the *real* terminal outside supports true color (RGB)
# and that it should handle OSC clipboard sequences (Ms) via pbcopy.
set -ga terminal-overrides ",xterm-256color*:Tc"
set -ga terminal-overrides ",alacritty*:Tc"
set -ga terminal-overrides ",*-256color*:Tc"

# Prevent rogue escape sequences from passing through to the terminal.
# This stops OSC color query responses from appearing as visible text.
set -g allow-passthrough off

# Enable tmux's built-in OSC 52 clipboard integration.
# When you yank text in copy mode, tmux will use the OSC 52 escape
# sequence to set the system clipboard directly through the terminal.
# This works with iTerm2, Terminal.app, Alacritty, and most modern terminals.
set -g set-clipboard on

# Set escape-time to 50ms (instead of 0).
# A value of 0 prevents tmux from properly intercepting multi-byte escape sequences 
# (like OSC 10/11 color query responses from the terminal), causing them to leak as garbage text.
# 50ms is still fast enough to not be noticeable in Vim.
set -s escape-time 50
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set-option -g renumber-windows on
set-window-option -g mode-keys vi

# ============================================================================
# KEY BINDINGS
# ============================================================================
# Prefix configuration (default: Ctrl+b)
bind-key C-a send-prefix

# Reload configuration
bind r source-file ~/.tmux.conf \; display "Config reloaded!"

# Pane splitting
unbind %
bind h split-window -h -c "#{pane_current_path}"
bind v split-window -v -c "#{pane_current_path}"

# Vim-style pane switching
bind -r ^ last-window
bind -r k select-pane -U
bind -r j select-pane -D
# bind -r h select-pane -L
bind -r l select-pane -R

# ============================================================================
# COPY MODE BINDINGS
# ============================================================================
# Enter copy mode with vi-style keys.
#
# Keyboard:
#   1. prefix + [ → enter copy mode
#   2. v → begin selection (vim-style)
#   3. y → copy to system clipboard and exit
#   Escape → leave copy mode
#
# Mouse (mouse mode is on, so tmux owns the mouse):
#   drag           → copies to system clipboard on release
#   double-click   → copy word
#   triple-click   → copy line
#
# Paste:
#   Cmd+V          → terminal types the system clipboard into the pane
#   prefix + C-v   → paste the system clipboard via tmux
#   prefix + ]     → paste tmux's own buffer
bind -T copy-mode-vi v send-keys -X begin-selection

# NOTE: y and MouseDragEnd1Pane are bound in the CLIPBOARD section at the very
# bottom of this file, after TPM. Binding them here does not work — tmux-yank
# loads later and overwrites anything set before `run tpm`.

# ============================================================================
# CUSTOM SHORTCUTS
# ============================================================================
bind -r D neww -c "#{pane_current_path}" "[[ -e TODO.md ]] && nvim TODO.md || nvim ~/.dotfiles/personal/todo.md"
bind-key -r f run-shell "tmux neww ~/.local/bin/tmux-sessionizer"
bind-key -r i run-shell "tmux neww tmux-cht.sh"

# Project shortcuts
bind-key -r G run-shell "~/.local/bin/tmux-sessionizer ~/work/rnrdp"
bind-key -r C run-shell "~/.local/bin/tmux-sessionizer ~/work/tvui"
bind-key -r R run-shell "~/.local/bin/tmux-sessionizer ~/work/milo"
bind-key -r H run-shell "~/.local/bin/tmux-sessionizer ~/personal/vim-with-me"
bind-key -r T run-shell "~/.local/bin/tmux-sessionizer ~/personal/refactoring.nvim"
bind-key -r N run-shell "~/.local/bin/tmux-sessionizer ~/personal/harpoon"
bind-key -r S run-shell "~/.local/bin/tmux-sessionizer ~/personal/developer-productivity"

# ============================================================================
# PLUGINS
# ============================================================================
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-yank'

# ORDER MATTERS: tmux-dotbar must load BEFORE tmux-continuum.
# TPM sources plugins in the order listed here. tmux-continuum implements its
# periodic autosave by appending a "#(continuum_save.sh)" interpolation to
# status-right, which tmux then re-evaluates every `status-interval` seconds.
# tmux-dotbar unconditionally overwrites status-right, so if dotbar loads last
# it wipes that hook and autosaving silently stops forever — leaving nothing
# for tmux-resurrect to restore after a reboot.
set -g @plugin 'vaaleyard/tmux-dotbar'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# ============================================================================
# PLUGIN CONFIGURATION
# ============================================================================
# Tmux Resurrect & Continuum
# Restore the last saved environment automatically when the tmux server starts.
set -g @continuum-restore 'on'

# Snapshot every 5 minutes. Continuum does NOT save on shutdown, so this
# interval is the worst-case amount of work lost on a reboot or power loss.
set -g @continuum-save-interval '5'

# Also save/restore pane scrollback, not just the layout.
set -g @resurrect-capture-pane-contents 'on'

# Restore nvim sessions (requires a Session.vim, e.g. via :mksession).
set -g @resurrect-strategy-nvim 'session'

# Tmux Yank — use system clipboard
set -g @yank_selection 'clipboard'
set -g @yank_selection_mouse 'clipboard'

### Tmux Dotbar Theme ###

# Background of the status bar
set -g @tmux-dotbar-bg "#1e1e2e"

# Inactive window text (not working: using the override)
# set -g @tmux-dotbar-fg "#008000"

# Current/Active window node color
set -g @tmux-dotbar-fg-current "#1591EA"

# Session node on the far left
set -g @tmux-dotbar-fg-session "#9399b2"

# Background color of the session node when tmux prefix is pressed
set -g @tmux-dotbar-fg-prefix "#cba6f7"

# OVERRIDE: Fix for the "Last Window" node which defaults to blue in some themes
set -g window-status-last-style "fg=#9399b2"

# OVERRIDE: Change the "Config Reloaded" message colors
set -g message-style "fg=#1e1e2e,bg=#1591EA,bold"
set -g message-command-style "fg=#1e1e2e,bg=#1591EA,bold"

set -g @tmux-dotbar-position "bottom"
set -g @tmux-dotbar-justify "absolute-centre"
set -g @tmux-dotbar-right "false"
set -g @tmux-dotbar-left "false"


# ============================================================================
# INITIALIZE TPM (Keep at bottom)
# ============================================================================
run '~/.tmux/plugins/tpm/tpm'
# ============================================================================
# CLIPBOARD — keep this section LAST, after the TPM run line above
# ============================================================================
# Loaded last on purpose so nothing can clobber it. Binding these before
# `run tpm` is silently useless: tmux-yank loads afterwards and overwrites
# them (the same load-order trap that disabled tmux-continuum's autosave).
#
# Why there is no "Cmd+C to copy" binding: macOS never delivers Cmd to the
# TTY, so tmux cannot see it, and Ctrl+C must stay SIGINT. Instead every
# selection path below pipes directly into the system clipboard, so the text
# is already there — no copy keystroke needed at all. Cmd+V still pastes
# normally, since that is the terminal typing the clipboard into the pane.
#
# One portable command handles both platforms: pbcopy on macOS, falling back
# to xclip when pbcopy is absent. Avoids nested if-shell blocks.

# --- Keyboard: v to select, y to copy ---------------------------------------
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel \
    "pbcopy 2>/dev/null || xclip -selection clipboard -i"

# --- Mouse drag: copies on release ------------------------------------------
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel \
    "pbcopy 2>/dev/null || xclip -selection clipboard -i"

# --- Double-click a word / triple-click a line ------------------------------
# tmux's defaults pipe to nothing, so these only reached the clipboard through
# OSC 52 — which VS Code's integrated terminal handles inconsistently. The
# if-shell guard is kept from the default binding: it passes the click through
# to programs that do their own mouse handling (vim, less) instead of hijacking it.
bind -T root DoubleClick1Pane select-pane -t = \; if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -H ; send-keys -X select-word ; run-shell -d 0.3 ; send-keys -X copy-pipe-and-cancel "pbcopy 2>/dev/null || xclip -selection clipboard -i" }
bind -T root TripleClick1Pane select-pane -t = \; if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -H ; send-keys -X select-line ; run-shell -d 0.3 ; send-keys -X copy-pipe-and-cancel "pbcopy 2>/dev/null || xclip -selection clipboard -i" }
bind -T copy-mode-vi DoubleClick1Pane select-pane \; send-keys -X select-word \; run-shell -d 0.3 \; send-keys -X copy-pipe-and-cancel "pbcopy 2>/dev/null || xclip -selection clipboard -i"
bind -T copy-mode-vi TripleClick1Pane select-pane \; send-keys -X select-line \; run-shell -d 0.3 \; send-keys -X copy-pipe-and-cancel "pbcopy 2>/dev/null || xclip -selection clipboard -i"

# --- Paste the SYSTEM clipboard ---------------------------------------------
# prefix + ] pastes tmux's own buffer, which drifts out of sync with what you
# copied outside tmux. This always pastes what the OS clipboard holds.
bind C-v run-shell \
    "(pbpaste 2>/dev/null || xclip -selection clipboard -o) | tmux load-buffer - && tmux paste-buffer"

# --- Escape leaves copy mode ------------------------------------------------
# Default only clears the selection, leaving you stuck in copy mode.
bind -T copy-mode-vi Escape send-keys -X cancel
